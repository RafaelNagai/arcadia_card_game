# Copy to .env.local (gitignored) to override for local development.
# Defaults to localhost:1999 (matches packages/server's `wrangler dev --port 1999`) when
# unset — see game/clientId.ts and hooks/useOnlineMatch.ts.
VITE_PARTYKIT_HOST=localhost:1999

# Once deployed (npm run deploy --workspace=packages/server, i.e. `wrangler deploy`), use
# whatever host wrangler prints — typically eltyca.<your-subdomain>.workers.dev unless you've
# configured a custom domain in wrangler.jsonc:
# VITE_PARTYKIT_HOST=eltyca.<your-subdomain>.workers.dev

# When deploying the web app itself (e.g. Cloudflare Pages), set this same variable in the
# host's dashboard under Settings -> Environment variables — .env.local never leaves your
# machine, so the deployed build won't see it otherwise.
